# Copy to .env for local development. Every setting has a working default -- this file
# exists to show the shape and to say which ones a deployment must actually think about.
# Full reference and the hardening checklist: docs/operations.md
#
# A PERSONA_-prefixed variable that matches no setting is a STARTUP ERROR, not a warning.
# Misspell PERSONA_AUDIENCE and the service refuses to start naming the offender, rather
# than running on the default audience with nothing in the logs to say so.

# --- Identity and logging ---------------------------------------------------------
PERSONA_APP_NAME=persona
PERSONA_ENVIRONMENT=local
PERSONA_LOG_LEVEL=INFO
# json in deployment, console for readable local output
PERSONA_LOG_FORMAT=console

# --- Serving ----------------------------------------------------------------------
# Loopback on purpose. This service belongs behind a TLS-terminating proxy.
PERSONA_HOST=127.0.0.1
PERSONA_PORT=8004

# --- Storage ----------------------------------------------------------------------
# One SQLite file, kept at mode 0600. NOTHING IN IT IS ENCRYPTED: a persona is plain
# text, and the file mode is the only thing between it and every other process on the
# box. Never put it inside a directory anything serves from.
PERSONA_DATABASE_PATH=var/persona.db

# --- Authenticating against keyring -----------------------------------------------
# Tokens are verified LOCALLY against keyring's published keys, by keyring-client -- the
# verifier every service in the family shares. persona-api never calls keyring at request
# time, and never asks it anything about an account.
#
# Must match keyring's KEYRING_ISSUER exactly -- it is pinned against the token's `iss`.
PERSONA_KEYRING_ISSUER=http://127.0.0.1:8001
PERSONA_KEYRING_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
# Pinned against the token's `aud`, exactly: `persona.work` is refused like `example-tool`.
# Callers mint one with:
#   POST /v1/auth/service-token {"audience": "persona"}
# keyring mints a token for whatever audience it is asked for, so nothing needs setting on
# keyring's side. In particular persona-api needs NO entry in KEYRING_SERVICE_TOKENS: that
# only admits services to keyring's /v1/internal endpoints, which persona-api never calls.
PERSONA_AUDIENCE=persona
# How long a fetched key set is used before it is fetched again. Keys from a good fetch
# keep verifying tokens for up to a day past this while keyring cannot be reached.
PERSONA_JWKS_CACHE_SECONDS=3600
# The floor between two fetches provoked by an unknown `kid`, and between a failed fetch
# and the next attempt. Not a tuning knob: without it, a stream of tokens carrying random
# kids is an outbound-fetch amplifier pointed at keyring.
PERSONA_JWKS_MIN_REFETCH_SECONDS=60
PERSONA_KEYRING_HTTP_TIMEOUT_SECONDS=5

# --- Limits -----------------------------------------------------------------------
PERSONA_MAX_PERSONAS_PER_ACCOUNT=20
PERSONA_MAX_FIELDS_PER_PERSONA=500
PERSONA_MAX_NOTES_PER_PERSONA=5000
# Pinned entries go into the assistant's prompt every turn, so these are really
# "how much of the context window may a persona spend on itself".
PERSONA_MAX_PINNED_FIELDS=20
PERSONA_MAX_PINNED_NOTES=20
PERSONA_MAX_FIELD_VALUE_BYTES=4096
PERSONA_MAX_VALUE_DEPTH=3
PERSONA_MAX_VALUE_LIST_ITEMS=100
PERSONA_MAX_VALUE_OBJECT_KEYS=50
PERSONA_MAX_NOTE_BODY_CHARS=4000
PERSONA_MAX_EVENTS=10000
PERSONA_RECALL_DEFAULT_LIMIT=20
PERSONA_RECALL_MAX_LIMIT=100

# --- Per-person settings (settings-api) ----------------------------------------------
# Off unless both are set. Unset, every person gets the limits above, which is today's
# behaviour exactly. Set, each request reads that caller's `persona` namespace: they may
# lower recall_default_limit, max_pinned_fields and max_pinned_notes, never raise them
# above this deployment. The token is this service's entry in settings-api's
# SETTINGS_API_SERVICES (32+ characters); the grant's audience_prefix must equal
# PERSONA_AUDIENCE. Neither value is logged.
#
# PERSONA_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
# PERSONA_SETTINGS_API_TOKEN=
#
# Catalogue entries that do nothing here yet: default_persona (no default-selection rule),
# log_values (the event log records no old values), erasure_mode and grace_days (no sweeper).

# --- Deliberately absent ----------------------------------------------------------
# There is no setting that disables token verification.
# There is no setting that lets one account read another's persona.
# There is no setting that turns off the credential refusal.
# There is no setting that permits an unsigned or HS256 token.
